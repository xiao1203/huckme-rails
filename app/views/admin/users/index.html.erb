<div class="breadcrumb"><%= link_to "ホーム", root_path %> &raquo; 管理画面</div>
<div class="section-title"><span>会員管理</span></div>

<div class="card" style="margin-bottom:16px;">
  <%= form_with url: admin_users_path, method: :get, local: true, class: "search-form", style: "max-width:400px;" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "ユーザー名・メールで検索" %>
    <%= f.submit "検索" %>
  <% end %>
</div>

<div class="card" style="padding:0; overflow-x:auto;">
  <table class="data-table">
    <tr><th>ID</th><th>ユーザー名</th><th>メール</th><th>権限</th><th>SSN</th><th>カード番号</th></tr>
    <% @users.each do |u| %>
      <tr>
        <td><%= link_to u.id, admin_user_path(u) %></td>
        <td><%= u.username %></td>
        <td><%= u.email %></td>
        <td><%= u.role %></td>
        <td><%= u.ssn %></td>
        <td><%= u.credit_card_number %></td>
      </tr>
    <% end %>
  </table>
</div>
