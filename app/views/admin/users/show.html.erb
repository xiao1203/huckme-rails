<div class="breadcrumb"><%= link_to "ホーム", root_path %> &raquo; <%= link_to "管理画面", admin_users_path %> &raquo; ユーザー #<%= @user.id %></div>

<div class="card" style="max-width:420px;">
  <h1 style="font-size:18px;">ユーザー編集</h1>
  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, local: true do |f| %>
    <div class="form-group">
      <%= f.label :username, "ユーザー名" %>
      <%= f.text_field :username %>
    </div>
    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.text_field :email %>
    </div>
    <div class="form-group">
      <%= f.label :role, "権限" %>
      <%= f.text_field :role %>
    </div>
    <%= f.submit "保存", class: "btn" %>
  <% end %>
</div>
