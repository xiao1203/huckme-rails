<div style="max-width:380px; margin:20px auto;">
  <div class="card">
    <h1 style="font-size:20px; text-align:center;">ログイン</h1>
    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.text_field :email %>
      </div>
      <div class="form-group">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password %>
      </div>
      <%= f.submit "ログイン", class: "btn btn-block" %>
    <% end %>
    <p style="text-align:center; font-size:13px; margin-top:16px;">
      アカウントをお持ちでないですか？ <%= link_to "新規登録はこちら", signup_path %>
    </p>
  </div>
</div>
