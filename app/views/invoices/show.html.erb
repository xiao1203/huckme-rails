<div class="breadcrumb"><%= link_to "ホーム", root_path %> &raquo; <%= link_to "注文履歴", invoices_path %> &raquo; 注文 #<%= @invoice.id %></div>

<div class="card">
  <h1 style="font-size:20px;">注文詳細 #<%= @invoice.id %></h1>
  <table class="data-table" style="margin-top:12px;">
    <tr><th>注文者 ID</th><td><%= @invoice.user_id %></td></tr>
    <tr><th>商品名</th><td><%= @invoice.title %></td></tr>
    <tr><th>金額</th><td>¥<%= number_with_delimiter(@invoice.amount.to_i) %></td></tr>
    <tr><th>状態</th><td>
      <span class="status-pill <%= @invoice.status == 'paid' ? 'status-paid' : 'status-unpaid' %>">
        <%= @invoice.status == 'paid' ? '支払い済み' : '未払い' %>
      </span>
    </td></tr>
    <tr><th>注文日</th><td><%= @invoice.created_at.strftime("%Y年%m月%d日 %H:%M") %></td></tr>
  </table>
</div>
