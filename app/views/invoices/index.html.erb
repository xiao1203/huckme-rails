<div class="breadcrumb"><%= link_to "ホーム", root_path %> &raquo; 注文履歴</div>
<div class="section-title"><span>注文履歴</span></div>

<ul class="plain">
  <% @invoices.each do |inv| %>
    <li class="order-row">
      <div>
        <div class="title"><%= link_to inv.title, invoice_path(inv) %></div>
        <div class="meta">注文番号 #<%= inv.id %> &middot; <%= inv.created_at.strftime("%Y年%m月%d日") %></div>
      </div>
      <div style="text-align:right;">
        <div style="font-weight:700;">¥<%= number_with_delimiter(inv.amount.to_i) %></div>
        <span class="status-pill <%= inv.status == 'paid' ? 'status-paid' : 'status-unpaid' %>">
          <%= inv.status == 'paid' ? '支払い済み' : '未払い' %>
        </span>
      </div>
    </li>
  <% end %>
</ul>
